    },
    {
      "group": "الأسعار والدفعات",
      "q": "كيف أقسّم العربون والدفعات؟",
      "a": "تختار خطة جاهزة مثل 50/50 أو 40/40/20، أو تكتب خطتك حتى 12 دفعة مربوطة بالعقد أو ببدء مرحلة أو باكتمال التسليم. ويصل العميل تذكير قبل كل دفعة."
    },
    {
      "group": "التصنيع",
      "q": "أصنّع لدى مصنع خارجي، هل يناسبني OpsOne؟",
      "a": "نعم. المسار الجاهز يرسل أمر شراء للمصنع بموعد متوقع، ثم يستلم القطع مع فحص الجودة، وتعرض لوحة المصانع ما تأخر."
    },
    {
      "group": "التصنيع",
      "q": "ولو كان عندي مصنعي الخاص؟",
      "a": "تضيف مراحل التصنيع الداخلي: تجهيز المواد، والقص والتصنيع، والتجميع والتشطيب، وفحص الجودة بصورة إلزامية. ولكل مرحلة مسؤول ومدة."
    },
    {
      "group": "التركيب والبيع",
      "q": "هل يوقّع العميل على الاستلام في الموقع؟",
