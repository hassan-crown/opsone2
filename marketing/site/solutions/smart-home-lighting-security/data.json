  "faqTitle": "أسئلة شركات الأنظمة الذكية",
  "faq": [
    {
      "q": "هل يناسب OpsOne شركة تركّب المنازل الذكية والكاميرات معًا؟",
      "a": "نعم. الطلب الواحد يجمع الإنارة والتحكم والكاميرات والأمن والشبكة بنودًا في عرض سعر واحد، ويمر بمراحل تضبطها أنت: المعاينة، وجدول الأجهزة، والعقد، والتمديد، والتركيب والبرمجة، والتسليم."
    },
    {
      "q": "كيف أنظّم موعد التمديد مع مقاول العميل؟",
      "a": "مرحلة التمديد لها موعد ومسؤول ومدة، ويصل العميل تذكير بواتساب أو رسالة نصية قبل الموعد المؤكد. وينبّهك التقويم إن تعارض موعدان لنفس الفريق، وتُنبَّه حين تتأخر المرحلة عن موعدها."
    },
    {
      "q": "هل يعتمد العميل مخطط توزيع الأجهزة من جواله؟",
      "a": "نعم. يصله المخطط في صفحته فيعتمده أو يطلب تعديله مع ملاحظة، وكل تعديل يصبح نسخة جديدة، وتبقى النسخ السابقة محفوظة بتاريخها."
    },
    {
      "q": "هل أتابع الأجهزة التي طلبتها من الموزّع؟",
      "a": "نعم. أمر الشراء يحمل موعدًا متوقعًا من مدة توريد الموزّع، وتسجّل عند الاستلام الكميات المقبولة والمرفوضة وسبب الرفض. وما في مخزونك يُحجز للطلب عند تأكيده."
    },
    {
      "q": "هل يتابع النظام الضمان والصيانة بعد التسليم؟",
      "a": "مدة ضمان الأجهزة وضمان التركيب بند تكتبه في العقد الموقّع، فيبقى مرجعه محفوظًا مع الطلب. وزيارة الصيانة أو البلاغ بعد التسليم تُسجَّل طلبًا جديدًا على ملف العميل نفسه. لا يوجد اليوم سجل ضمان مستقل ولا عقود صيانة دورية تتجدد تلقائيًا."
    },
    {
      "q": "هل يزور البائع الميداني الموقع ويرسل العرض من جواله؟",
      "a": "نعم. يوزّع المشرف الفرصة على بائع ميداني، فيرى فرصه ومواعيده على جواله، ويسجّل صور الموقع ومقاساته أثناء الزيارة، ثم يرسل عرض السعر ورابط توقيع العقد. ويُنسب الطلب إليه وإلى قناة البيع الميداني في التقارير."
    },
    {
      "q": "كيف أقسّم دفعات المشروع؟",
      "a": "تختار خطة جاهزة مثل 40/40/20 أو 50/50، أو تكتب خطتك حتى 12 دفعة، مربوطة بالعقد أو اعتماد التصميم أو بدء مرحلة مثل التمديد أو اكتمال التسليم. ويصل العميل تذكير قبل كل دفعة."
    },
    {
      "q": "هل أبيع الكاميرات واللمبات الذكية الجاهزة أونلاين؟",
      "a": "نعم. المتجر الإلكتروني يبيع المنتجات الجاهزة من المخزون نفسه بدفع إلكتروني، ومعه كوبونات وروابط سلة ترسلها لعميلك."
    }
  ],
