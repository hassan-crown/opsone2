APP_NAME=OpsOne
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_URL is https://
# SESSION_SECURE_COOKIE=true
# Proxies whose X-Forwarded-* headers are trusted (default: private ranges)
# TRUSTED_PROXIES=172.16.0.0/12

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Signed license (ADR-0004). Public key only; local/testing can use `php artisan license:dev-issue`.
LICENSE_PUBLIC_KEY=
LICENSE_KEY_ID=opsone-production
LICENSE_DEPLOYMENT_ID=

# Operations (ADR-0028, docs/runbook.md). Release id shown in backups and ops:preflight.
APP_VERSION=dev
# Backup key: `php artisan ops:backup-key`. Never the APP_KEY; keep a copy OUTSIDE the server or backups are unrecoverable.
OPS_BACKUP_KEY=
OPS_BACKUP_ENABLED=true
OPS_BACKUP_TIME=02:30
OPS_BACKUP_RETENTION_DAYS=30
# `backups` (local, private) or `backups_s3` (off-server, Q-54: chosen and approved by the server admin).
OPS_BACKUP_DISK=backups
OPS_BACKUP_DIRECTORY=opsone
OPS_BACKUP_S3_KEY=
OPS_BACKUP_S3_SECRET=
OPS_BACKUP_S3_REGION=
OPS_BACKUP_S3_BUCKET=
OPS_BACKUP_S3_ENDPOINT=
OPS_BACKUP_S3_PATH_STYLE=false
OPS_PREFLIGHT_MAX_BACKUP_AGE_HOURS=24

VITE_APP_NAME="${APP_NAME}"

# OpsOne support (SHR-14, ADR-0008): support requests are mailed here; access windows in hours.
OPSONE_SUPPORT_EMAIL=
OPSONE_SUPPORT_MAX_ACCESS_HOURS=72
OPSONE_SUPPORT_REQUEST_TTL_HOURS=72

# Moyasar (store payments, ADR-0023): TEST keys only, normally set in the facility's payment settings instead.
MOYASAR_TEST_PUBLISHABLE_KEY=
MOYASAR_TEST_SECRET_KEY=
MOYASAR_TEST_WEBHOOK_SECRET=
